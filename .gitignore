# ----------------------------------------------------------------------
# 1. DEPENDENCIES AND BUILD ARTIFACTS
# ----------------------------------------------------------------------

# Node Package Manager (npm) dependencies and cache
/node_modules
/package-lock.json
/yarn.lock
/.pnp
.pnp.js

# Build output directories
# Vite defaults to 'dist' for production builds
/dist
/build
/out
/donorsashboard-app
/my-react-app


# Runtime data
.eslintcache

# ----------------------------------------------------------------------
# 2. LOGS AND DEBUGGING
# ----------------------------------------------------------------------

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store

# ----------------------------------------------------------------------
# 3. ENVIRONMENT AND SECRETS
# ----------------------------------------------------------------------

# Environment variables file
# This file often contains API keys or configuration secrets!
.env
.env.development
.env.production
.env.*.local

# Local history/state files
.npmrc

# ----------------------------------------------------------------------
# 4. IDE and OS Files
# ----------------------------------------------------------------------

# macOS system files
.DS_Store

# Windows system files
Thumbs.db

# Visual Studio Code (VS Code)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history

# IntelliJ/WebStorm
.idea
*.iml
